{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"poker-club",
  "main":"src/casino-mine-main.js",
  "compatibility_date":"2026-08-19",
  "assets":{
    "directory":"./public",
    "binding":"ASSETS",
    "run_worker_first":true
  },
  "d1_databases":[
    {
      "binding":"DB",
      "database_name":"poker-club-db",
      "database_id":"__D1_DATABASE_ID__",
      "migrations_dir":"migrations"
    }
  ],
  "migrations":[
    {
      "tag":"v1",
      "new_sqlite_classes":["PokerTableDO"]
    },
    {
      "tag":"v2",
      "new_sqlite_classes":["RussianRouletteDO"]
    },
    {
      "tag":"v3-casino-reboot",
      "deleted_classes":["PokerTableDO","RussianRouletteDO"]
    }
  ],
  "vars":{
    "APP_NAME":"FIT CASINO",
    "APP_URL":"https://poker-club.btctgjr4t2.workers.dev",
    "TELEGRAM_BOT_USERNAME":"fitpokerclubbot"
  }
}
